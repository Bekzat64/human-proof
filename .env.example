# Copy to .env.local for local dev. Never commit real values.
# In production these live in Vercel → Project → Settings → Environment Variables.

# --- Stage 0: database -------------------------------------------------------
# Neon Postgres connection string (pooled). Vercel's Neon integration sets this
# automatically; pull it locally with `vercel env pull .env.local`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- LLM (optional) -----------------------------------------------------------
# With no key for the selected provider the app still works end to end: the
# copilot answers in labelled "offline" mode and reasoning is scored by rules.
# Add a key and both switch to the model on their own; then run
# `pnpm regrade --heuristic-only` to re-score earlier attempts.
LLM_PROVIDER="anthropic"            # anthropic | google | openai
ANTHROPIC_API_KEY=""                # used when LLM_PROVIDER=anthropic
GOOGLE_GENERATIVE_AI_API_KEY=""     # used when LLM_PROVIDER=google
OPENAI_API_KEY=""                   # used when LLM_PROVIDER=openai
# Optional overrides. Defaults per provider (copilot / grader):
#   anthropic  claude-haiku-5-5 / claude-sonnet-5-5
#   google     gemini-flash-latest / gemini-pro-latest
#   openai     gpt-6-luna / gpt-6.1-sol
# COPILOT_MODEL=""
# GRADER_MODEL=""

# --- Site URL (optional) -------------------------------------------------------
# Proof links are built from the request's own host. Set this only to force a
# canonical origin, e.g. a custom domain.
# SITE_URL="https://example.com"

# --- Job-Search Pass (optional) ------------------------------------------------
# With a Stripe TEST key, "Get the pass" goes through Stripe Checkout. Without
# one, a labelled demo checkout creates the pass (no charge). Live keys are
# refused on purpose.
# STRIPE_SECRET_KEY="sk_test_..."

# --- /stats (optional) -----------------------------------------------------------
# Our own test identities (hp_anon cookie values), comma-separated. They and any
# anon id starting with "qa-" are left out of the public stats.
# QA_ANON_IDS="abc123,def456"
