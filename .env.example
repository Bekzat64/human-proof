# Copy to .env.local for local dev. Never commit real values.
# In production these live in Vercel → Project → Settings → Environment Variables.

# --- Stage 0: database -------------------------------------------------------
# Neon Postgres connection string (pooled). Vercel's Neon integration sets this
# automatically; pull it locally with `vercel env pull .env.local`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Needed from Stage 2 (copilot) and Stage 3 (grading) ---------------------
ANTHROPIC_API_KEY=""
COPILOT_MODEL="claude-haiku-5-5"
# GRADER_MODEL="claude-sonnet-5-5"

# --- Needed from Stage 6 (Job-Search Pass, Stripe test mode) ------------------
# STRIPE_SECRET_KEY="sk_test_..."
